

.triviaCorrecto {
    background-color: green;
}

.triviaIncorrecto {
    background-color: red;
}


/* ============================= */
/* TITULOS                       */
/* ============================= */

h2 {
    margin-bottom: 2rem;
    color: #493657;
    font-size: 2.5rem;
}

h3 {
    color: #493657;
}

/* ============================= */
/* SECCIONES                     */
/* ============================= */

#triviaInicio,
#triviaJuego,
#triviaFinal {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem;
    border-radius: 1.5rem;
    background-color: white;
    box-shadow: 0 0.5rem 1.5rem rgba(73, 54, 87, 0.15);
}

#triviaInicio {
    background-color: #D2E0BF;
}

#triviaFinal {
    background-color: #BE95C4;
}

/* ============================= */
/* BOTONES                       */
/* ============================= */

button {
    padding: 0.8rem 1.5rem;
    border: none;
    border-radius: 0.7rem;
    background-color: #9F86C0;
    color: #FFF8E5;
    font-size: 1rem;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s;
}

button:hover {
    background-color: #493657;
    transform: scale(1.03);
}

button:disabled {
    cursor: not-allowed;
    opacity: 0.8;
}

/* ============================= */
/* BOTON COMENZAR / REINICIAR    */
/* ============================= */

#triviaComenzar,
#triviaReiniciar {
    margin-top: 1.5rem;
    background-color: #493657;
}

#triviaComenzar:hover,
#triviaReiniciar:hover {
    background-color: #9F86C0;
}

/* ============================= */
/* ESTADISTICAS                  */
/* ============================= */

#triviaStats {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
}

#triviaStats p {
    margin: 0;
    padding: 0.8rem 1.2rem;
    border-radius: 0.7rem;
    background-color: #D2E0BF;
    font-weight: bold;
}

/* ============================= */
/* BANDERA                       */
/* ============================= */

#imgBandera {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
}

#imgBandera img {
    width: 60%;
    max-width: 30rem;
    border-radius: 1rem;
    box-shadow: 0 0.4rem 1rem rgba(73, 54, 87, 0.2);
}

/* ============================= */
/* OPCIONES                      */
/* ============================= */

#triviaOpciones {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 2rem 0;
}

#triviaOpciones button {
    width: 40%;
    background-color: #BE95C4;
    color: #493657;
}

#triviaOpciones button:hover {
    background-color: #9F86C0;
    color: #FFF8E5;
}

/* ============================= */
/* RESPUESTAS                    */
/* ============================= */

#triviaOpciones button.correcto {
    background-color: #D2E0BF;
    color: #493657;
}

#triviaOpciones button.incorrecto {
    background-color: #9F86C0;
    color: #FFF8E5;
}

/* Evita que hover cambie el color de una respuesta */
#triviaOpciones button.correcto:hover,
#triviaOpciones button.incorrecto:hover {
    transform: none;
}

/* ============================= */
/* SIGUIENTE                     */
/* ============================= */

#triviaSiguiente {
    margin-top: 1rem;
    background-color: #493657;
}

/* ============================= */
/* RESULTADO FINAL               */
/* ============================= */

#triviaResultado {
    font-size: 2rem;
    color: #493657;
}

#triviaPuntaje {
    font-size: 1.5rem;
    font-weight: bold;
}

/* ============================= */
/* FORMULARIO                    */
/* ============================= */

#triviaJugador {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    margin: 2rem 0;
}

#triviaJugador input {
    width: 60%;
    padding: 0.8rem;
    border: 0.15rem solid #9F86C0;
    border-radius: 0.7rem;
    background-color: #FFF8E5;
    color: #493657;
    font-size: 1rem;
}

#triviaJugador input:focus {
    outline: none;
    border-color: #493657;
}

/* ============================= */
/* TEXTO DE CARGA                */
/* ============================= */

#triviaEstado {
    margin: 1rem 0;
    color: #9F86C0;
    font-weight: bold;
}

/* ============================= */
/* RESPONSIVE                    */
/* ============================= */

@media (max-width: 40rem) {

    body {
        padding: 1rem 4%;
    }

    #triviaInicio,
    #triviaJuego,
    #triviaFinal {
        padding: 1.5rem;
    }

    h2 {
        font-size: 2rem;
    }

    #triviaStats {
        flex-direction: column;
    }

    #triviaOpciones {
        flex-direction: column;
    }

    #triviaOpciones button {
        width: 100%;
    }

    #imgBandera img {
        width: 90%;
    }

    #triviaJugador input {
        width: 100%;
    }
}
